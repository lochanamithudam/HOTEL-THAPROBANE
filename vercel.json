{
  "framework": null,
  "cleanUrls": true,
  "headers": [
    {
      "source": "/fonts/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ],
  "rewrites": [
    { "source": "/api/bookings", "destination": "/api/bookings.js" },
    { "source": "/api/subscribe", "destination": "/api/subscribe.js" },
    { "source": "/api/test-email", "destination": "/api/test-email.js" }
  ]
}
